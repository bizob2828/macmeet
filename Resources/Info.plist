<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>MacMeet</string>
	<key>CFBundleExecutable</key>
	<string>MacMeet</string>
	<key>CFBundleIdentifier</key>
	<string>local.macmeet.MacMeet</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MacMeet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>MacMeet Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>macmeet</string>
			</array>
		</dict>
		<dict>
			<!-- Lets link routers such as Finicky or Velja hand Meet links to MacMeet. The
			     Alternate rank keeps macOS from ever picking MacMeet as the default browser. -->
			<key>CFBundleURLName</key>
			<string>Google Meet Link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSCameraUsageDescription</key>
	<string>MacMeet needs camera access so others can see you in Google Meet calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MacMeet needs microphone access so others can hear you in Google Meet calls.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
</dict>
</plist>
